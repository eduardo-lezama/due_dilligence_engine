# Anthropic (optional — si está vacío el sistema usa OpenAI directamente)
ANTHROPIC_API_KEY=

# OpenAI (obligatorio si no hay ANTHROPIC_API_KEY)
OPENAI_API_KEY=sk-...

# SEC EDGAR identity (required by SEC — "Name email@example.com")
SEC_USER_AGENT=Your Name your@email.com

# Data source API keys (optional — degraded mode si no están configuradas)
POLYGON_API_KEY=        # polygon.io — precios, market cap, 52w range
FINNHUB_API_KEY=        # finnhub.io — noticias recientes
TAVILY_API_KEY=tvly-... # tavily.com — búsqueda web para agentes LLM

# Model defaults
DEFAULT_MODEL=claude-sonnet-4-6           # Claude (si tienes API key)
OPENAI_FALLBACK_MODEL=gpt-6-luna          # Especialistas (management, filings, competitive) — ADR-039
OPENAI_EXPERT_MODEL=gpt-6.1-sol           # Value Expert + Critic (síntesis final) — ADR-040

# Phase 2 feature tuning (optional — defaults are sensible)
TRANSCRIPT_QUARTERS=2          # Number of earnings call quarters to inject (default: 2)
EVENTS_LOOKBACK_MONTHS=12      # 8-K event lookback window in months (default: 12)

# Performance tracking (ADR-021)
USD_EUR_RATE=0.93              # Fixed USD→EUR rate for cost reporting (update when needed)

# Storage paths (relative to project root)
DB_PATH=data/analyses.db
REPORTS_DIR=data/reports
